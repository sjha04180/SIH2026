// prisma/schema.prisma

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  name         String
  role         String        // STUDENT, FACULTY, COORDINATOR, ADMIN, PRINCIPAL
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  student      Student?
  faculty      Faculty?
  coordinator  Coordinator?
  principal    Principal?
}

model Institution {
  id        String       @id @default(uuid())
  name      String       @unique
  code      String       @unique
  departments Department[]
  students  Student[]
}

model Department {
  id            String      @id @default(uuid())
  name          String      @unique
  code          String      @unique
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id])
  programs      Program[]
  students      Student[]
}

model Program {
  id           String     @id @default(uuid())
  name         String
  code         String     @unique
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id])
  students     Student[]
}

model Student {
  id                String                @id @default(uuid())
  userId            String                @unique
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rollNumber        String                @unique
  institutionId     String
  institution       Institution           @relation(fields: [institutionId], references: [id])
  departmentId      String
  department        Department            @relation(fields: [departmentId], references: [id])
  programId         String
  program           Program               @relation(fields: [programId], references: [id])
  currentSemester   Int
  batch             String
  cgpa              Float
  sgpa              Float
  attendance        Float
  profileCompletion Int                   @default(80)
  profileSummary    String?
  interests         String?
  activities        Activity[]
  contributions     ProjectContribution[]
  academicRecords   AcademicRecord[]
  profileLinks      ProfileLink[]
  studentSkills     StudentSkill[]
}

model Faculty {
  id              String            @id @default(uuid())
  userId          String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  department      String
  activities      Activity[]        @relation("FacultyReviewer")
  contributions   ProjectContribution[] @relation("FacultyContributionReviewer")
}

model Coordinator {
  id            String            @id @default(uuid())
  userId        String            @unique
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  scope         String            // E.g., "ACM Club", "MumbaiHacks"
  activities    Activity[]        @relation("CoordinatorReviewer")
  events        Event[]
  sigs          SIG[]
}

model Principal {
  id      String @id @default(uuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AcademicRecord {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester   Int
  sgpa       Float
  cgpa       Float
  attendance Float
  examStatus String   @default("PASS") // PASS, FAIL, PENDING
  createdAt  DateTime @default(now())
}

model ActivityCategory {
  id                     String     @id @default(uuid())
  name                   String     @unique // e.g. Hackathon, Workshop, YouTube Learning
  requiresEvidence       Boolean    @default(true)
  evidenceClass          String     // E.g., CERTIFICATE, SCREENSHOT, NONE
  verificationType       String     // E.g., EVENT_COORDINATOR, FACULTY_TG, ADMIN_INSTITUTIONAL, SELF_DECLARED
  verificationRequired   Boolean    @default(true)
  allowedSelfDeclaration Boolean    @default(true)
  verificationAuthority  String     // E.g., HOD, FACULTY, COORDINATOR, NONE
  activities             Activity[]
}

model Activity {
  id                    String            @id @default(uuid())
  studentId             String
  student               Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  categoryId            String?
  category              ActivityCategory? @relation(fields: [categoryId], references: [id])
  type                  String            // Workshop, Seminar, Hackathon, YouTube Learning, etc. (kept for UI mapping)
  title                 String
  date                  DateTime
  organiser             String
  role                  String
  description           String
  outcome               String?
  evidenceUrl           String?
  evidenceType          String?           // PDF, Image, URL, Document
  externalLink          String?
  verificationRoute     String            // ADMIN_INSTITUTIONAL, FACULTY_TG, EVENT_COORDINATOR, SELF_DECLARED
  status                String            @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, VERIFIED, RETURNED, REJECTED, SELF_DECLARED
  reviewerId            String?           // ID of the reviewer (faculty or coordinator)
  reviewerName          String?
  reviewerComment       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  logs                  VerificationLog[]
  evidenceList          Evidence[]
  
  // Relations back to Faculty and Coordinator
  facultyReviewerId     String?
  facultyReviewer       Faculty?          @relation("FacultyReviewer", fields: [facultyReviewerId], references: [id])
  coordinatorReviewerId String?
  coordinatorReviewer   Coordinator?      @relation("CoordinatorReviewer", fields: [coordinatorReviewerId], references: [id])
}

model Project {
  id            String                @id @default(uuid())
  name          String                @unique
  description   String
  type          String                // TEAM, PERSONAL
  startDate     DateTime
  endDate       DateTime
  repoUrl       String?
  demoUrl       String?
  hostingUrl    String?
  technologies  String                // Comma-separated list: "Next.js, Tailwind, Prisma"
  contributions ProjectContribution[]
  createdAt     DateTime              @default(now())
}

model ProjectContribution {
  id                    String            @id @default(uuid())
  studentId             String
  student               Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  projectId             String
  project               Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName           String            // Kept for direct fast query and UI migration compatibility
  projectDesc           String            // Kept for direct fast query and UI migration compatibility
  startDate             DateTime
  endDate               DateTime
  repoUrl               String?
  demoUrl               String?
  projectEvidence       String?
  role                  String            // Backend Developer, Designer, etc.
  contribution          String            // Designed REST APIs, database integration, etc.
  technologies          String            // Comma-separated list: "Node.js, Express, PostgreSQL"
  verificationRoute     String            @default("FACULTY_TG") // FACULTY_TG, SELF_DECLARED
  status                String            @default("DRAFT") // DRAFT, SUBMITTED, UNDER_REVIEW, VERIFIED, RETURNED, REJECTED, SELF_DECLARED
  reviewerId            String?           // ID of the reviewer (faculty)
  reviewerName          String?
  reviewerComment       String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  logs                  VerificationLog[]
  evidenceList          Evidence[]

  // Relations back to Faculty
  facultyReviewerId     String?
  facultyReviewer       Faculty?          @relation("FacultyContributionReviewer", fields: [facultyReviewerId], references: [id])
}

model Evidence {
  id             String               @id @default(uuid())
  activityId     String?
  activity       Activity?            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  contributionId String?
  contribution   ProjectContribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  fileName       String
  fileType       String
  fileSize       Int
  storagePath    String
  uploadedBy     String
  uploadedAt     DateTime             @default(now())
}

model VerificationLog {
  id             String               @id @default(uuid())
  activityId     String?
  activity       Activity?            @relation(fields: [activityId], references: [id], onDelete: Cascade)
  contributionId String?
  contribution   ProjectContribution? @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  actorId        String
  actorName      String
  action         String               // SUBMIT, VERIFY, RETURN, REJECT
  previousStatus String
  newStatus      String
  comment        String?
  createdAt      DateTime             @default(now())
}

model Skill {
  id            String         @id @default(uuid())
  name          String         @unique
  category      String         // Frontend, Backend, Database, Cloud, Mobile, Devops, SoftSkills
  studentSkills StudentSkill[]
}

model StudentSkill {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skillId    String
  skill      Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level      String   // Beginner, Intermediate, Expert
  status     String   @default("SELF_DECLARED") // SELF_DECLARED, VERIFIED
  verifiedBy String?
  createdAt  DateTime @default(now())
}

model Event {
  id            String       @id @default(uuid())
  name          String       @unique
  description   String
  date          DateTime
  coordinatorId String?
  coordinator   Coordinator? @relation(fields: [coordinatorId], references: [id])
}

model SIG {
  id            String       @id @default(uuid())
  name          String       @unique
  description   String
  coordinatorId String?
  coordinator   Coordinator? @relation(fields: [coordinatorId], references: [id])
}

model ProfileLink {
  id           String   @id @default(uuid())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  platformName String   // LinkedIn, GitHub, LeetCode, etc.
  profileUrl   String
  displayOrder Int      @default(0)
  isPublic     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())
}
